{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "declaration": true,
    "outDir": "lib",
    "rootDir": ".",
    "strict": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
